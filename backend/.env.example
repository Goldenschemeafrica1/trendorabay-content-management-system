# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=trendorabay
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# Google Analytics Configuration
# The Google Analytics View ID (required)
GA_VIEW_ID=your_ga_view_id

# Google Analytics Property ID (optional, for reference)
GA_PROPERTY_ID=your_ga_property_id

# OAuth2 Authentication Method
GA_CLIENT_ID=your_oauth_client_id
GA_CLIENT_SECRET=your_oauth_client_secret
GA_REFRESH_TOKEN=your_oauth_refresh_token

# Service Account Authentication Method (alternative to OAuth2)
GA_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GA_SERVICE_ACCOUNT_KEY=your_service_account_private_key

# Date range for analytics data (default: 30days)
GA_DATE_RANGE=30days

# Request timeout in milliseconds (default: 10000)
GA_TIMEOUT=10000

# Whether to use mock data if the API fails (default: false)
# Set to 'true' during development or if GA credentials are not configured
GA_USE_MOCK_DATA=true

# Cache duration for analytics data in seconds (default: 300)
GA_CACHE_DURATION=300
